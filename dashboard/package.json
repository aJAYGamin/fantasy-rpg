{
  "name": "amethyst-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Amethyst Dashboard: a local web dashboard for the Amethyst fantasy RPG",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web --prefix-colors magenta,cyan \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server/server/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
